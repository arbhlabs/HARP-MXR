<Project Sdk="Microsoft.NET.Sdk">
  <!-- Renders the 1.3 pad-grid overlay, the PAD cheatsheet and the MIDI settings window to PNG without starting MixDock.exe or touching audio. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net9.0-windows</TargetFramework><UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/MixDock/Log.cs" Link="Log.cs" />
    <Compile Include="../../src/MixDock/Ui/UiMetrics.cs" Link="Ui/UiMetrics.cs" />
    <Compile Include="../../src/MixDock/Ui/Theme.cs" Link="Ui/Theme.cs" />
    <Compile Include="../../src/MixDock/Ui/PadGridView.cs" Link="Ui/PadGridView.cs" />
    <Compile Include="../../src/MixDock/Ui/PadOverlay.cs" Link="Ui/PadOverlay.cs" />
    <Compile Include="../../src/MixDock/Ui/MidiSettingsForm.cs" Link="Ui/MidiSettingsForm.cs" />
    <Compile Include="../../src/MixDock/Platform/Gamepad.cs" Link="Platform/Gamepad.cs" />
    <Compile Include="../../src/MixDock/Platform/PadLogic.cs" Link="Platform/PadLogic.cs" />
    <Compile Include="../../src/MixDock/Platform/ActionCatalog.cs" Link="Platform/ActionCatalog.cs" />
    <Compile Include="../../src/MixDock/Platform/PadMapper.cs" Link="Platform/PadMapper.cs" />
    <Compile Include="../../src/MixDock/Platform/PadBanks.cs" Link="Platform/PadBanks.cs" />
    <Compile Include="../../src/MixDock/Platform/Midi.cs" Link="Platform/Midi.cs" />
    <Compile Include="../../src/MixDock/Audio/PadSynth.cs" Link="Audio/PadSynth.cs" />
    <Compile Include="../../src/MixDock/Audio/FxCurves.cs" Link="Audio/FxCurves.cs" />
    <Compile Include="../../src/MixDock/Audio/ChordTheory.cs" Link="Audio/ChordTheory.cs" />
    <Compile Include="../../src/MixDock/Audio/KeyDetector.cs" Link="Audio/KeyDetector.cs" />
    <Compile Include="../../src/MixDock/Settings/AppConfig.cs" Link="Settings/AppConfig.cs" />
  </ItemGroup>
</Project>
